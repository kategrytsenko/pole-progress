# Pole Progress — Supabase configuration reference.
#
# NOTE: Angular/Vite does NOT auto-load this file. The app reads its
# configuration from `apps/app/src/environments/environment.ts`
# (production) and `environment.development.ts` (dev). This file is a
# documentation reference for which values to put there when wiring a
# new deployment (one studio = one Supabase project + one frontend).
#
# Local stack defaults come from `supabase start`.

# REST endpoint of the Supabase project (e.g. https://<ref>.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321

# Anonymous publishable key for the project. Safe to ship to the browser.
# Local default is printed by `supabase start`; production value lives in
# the Supabase dashboard → Project settings → API.
SUPABASE_ANON_KEY=sb_publishable_xxx

# Google sign-in. The CLI reads these when `supabase start` loads config.toml.
# Create a Web client at https://console.cloud.google.com/auth/clients
# Local redirect URI:    http://127.0.0.1:54321/auth/v1/callback
# Hosted redirect URI:   https://<project-ref>.supabase.co/auth/v1/callback
# JavaScript origins:    http://localhost:4200 and http://127.0.0.1:4200
# Then set [auth.external.google] enabled = true and restart the local stack.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
